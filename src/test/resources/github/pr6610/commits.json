[{"sha":"c4c39e6187c1443a76c428fcf1bed5c2dccb5182","node_id":"C_kwDOJx3NCNoAKGM0YzM5ZTYxODdjMTQ0M2E3NmM0MjhmY2YxYmVkNWMyZGNjYjUxODI","commit":{"author":{"name":"Dmytro Liubarskyi","email":"ljubarskij@gmail.com","date":"2026-10-07T10:08:18Z"},"committer":{"name":"Dmytro Liubarskyi","email":"ljubarskij@gmail.com","date":"2026-10-07T10:11:15Z"},"message":"Decide in one place which AI Service methods call the model\n\nThe proxy, the validation and the tool error notice each had their own idea\nof which methods of an AI Service interface are implemented by calling the\nmodel. The notice even had to know about ChatMemoryAccess.\n\nAiServiceValidation.isImplementedByModel() is now the only place that says\nso: static and default methods run as written, Object and ChatMemoryAccess\nmethods are handled by the proxy itself, everything else calls the model.\n\n- The proxy dispatches everything else to invokeImplementedByProxy().\n- Validation no longer checks the return types of getChatMemory() and\n  evictChatMemory() as if they were AI Service methods. They passed only\n  because dev.langchain4j.memory is not among the packages whose types are\n  rejected.\n- The notice no longer looks at methods at all. DefaultAiServices tells it\n  whether a method returns neither an asynchronous nor a reactive type, and\n  the notice asks only when the AI Service has tools.\n\nTests cover a static method and ChatMemoryAccess in validation, and the\nChatMemoryAccess methods through the proxy without calling the model.","tree":{"sha":"8f878f1a863c96d2f7f4bf3ab0b86354c8c6cfa7","url":"https://api.github.com/repos/langchain4j/langchain4j/git/trees/8f878f1a863c96d2f7f4bf3ab0b86354c8c6cfa7"},"url":"https://api.github.com/repos/langchain4j/langchain4j/git/commits/c4c39e6187c1443a76c428fcf1bed5c2dccb5182","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/langchain4j/langchain4j/commits/c4c39e6187c1443a76c428fcf1bed5c2dccb5182","html_url":"https://github.com/langchain4j/langchain4j/commit/c4c39e6187c1443a76c428fcf1bed5c2dccb5182","comments_url":"https://api.github.com/repos/langchain4j/langchain4j/commits/c4c39e6187c1443a76c428fcf1bed5c2dccb5182/comments","author":{"login":"dliubarskyi","id":3154404,"node_id":"MDQ6VXNlcjMxNTQ0MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/3154404?v=4","gravatar_id":"","url":"https://api.github.com/users/dliubarskyi","html_url":"https://github.com/dliubarskyi","followers_url":"https://api.github.com/users/dliubarskyi/followers","following_url":"https://api.github.com/users/dliubarskyi/following{/other_user}","gists_url":"https://api.github.com/users/dliubarskyi/gists{/gist_id}","starred_url":"https://api.github.com/users/dliubarskyi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dliubarskyi/subscriptions","organizations_url":"https://api.github.com/users/dliubarskyi/orgs","repos_url":"https://api.github.com/users/dliubarskyi/repos","events_url":"https://api.github.com/users/dliubarskyi/events{/privacy}","received_events_url":"https://api.github.com/users/dliubarskyi/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"dliubarskyi","id":3154404,"node_id":"MDQ6VXNlcjMxNTQ0MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/3154404?v=4","gravatar_id":"","url":"https://api.github.com/users/dliubarskyi","html_url":"https://github.com/dliubarskyi","followers_url":"https://api.github.com/users/dliubarskyi/followers","following_url":"https://api.github.com/users/dliubarskyi/following{/other_user}","gists_url":"https://api.github.com/users/dliubarskyi/gists{/gist_id}","starred_url":"https://api.github.com/users/dliubarskyi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dliubarskyi/subscriptions","organizations_url":"https://api.github.com/users/dliubarskyi/orgs","repos_url":"https://api.github.com/users/dliub